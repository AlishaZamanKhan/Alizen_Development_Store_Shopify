<link rel="stylesheet" href="{{ 'article.css' |  asset_url }}">

<article class="article-container">
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'article_title' %}
        <div class="article-title-wrapper">
          <div class="article-title-container">
            <a href="{{ blog.url }}" class="blog-link">
              {{- blog.title -}}
            </a>
            <h1 class="main-title">{{ article.title }}</h1>
          </div>
        </div>

      {% when 'article_published_date' %}
        <div class="article-meta-wrapper">
          <div class="article-meta-container">
            {% if section.settings.enable_author %}
              <small class="article-author">{{ article.author }}</small>
            {% endif %}
          </div>
        </div>
      {% when 'article_published_date' %}
        <div class="article-meta-wrapper">
          <div class="article-meta-container">
            {% if section.settings.enable_published_date %}
              <time class="article-date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                {{- article.published_at | date: format: 'on_date' -}}
              </time>
            {% endif %}
          </div>
        </div>

      {% when 'featured_image' %}
        <div class="featured-image-wrapper">
          {% if article.image != blank %}
            <img
              class="featured-image"
              src="{{ article.image | image_url }}"
              alt="{{ article.image.alt }}"
              width="1200"
              height="600"
            >
          {% else %}
            {% assign placeholder_image = 'lifestyle-1' %}
            {{ placeholder_image | placeholder_svg_tag: 'placeholder-image' }}
          {% endif %}
        </div>

      {% when 'article_content' %}
        <div class="article-content-wrapper">
          <div class="article-content-container">
            {{ article.content }}
          </div>
        </div>
      {% else %}

    {% endcase %}
  {% endfor %}
</article>

{% if blog.comments_enabled? %}
  <div id="comments" class="comments-section">
    {% if article.comments_count > 0 %}
      <div class="comments-wrapper">
        <h1 class="comments-heading">See what people are saying</h1>

        {% paginate article.comments by 5 %}
          {% for comment in article.comments %}
            <div class="comment">
              <span class="comment-author">{{ comment.author }}</span>
              <span class="comment-date">
                {{ comment.created_at | date: formate: 'default' }}
              </span>
              <p class="comment-text">{{ comment.content }}</p>
            </div>
          {% endfor %}

          <div class="pagination-wrapper">
            {% render 'pagination', pagination: paginate %}
          </div>
        {% endpaginate %}
      </div>
    {% else %}
      <p class="no-comments">There are no comments in this article</p>
    {% endif %}
  </div>
  <div id="comment_form" class="comment-form-section">
    {% form 'new_comment', article %}
      <div class="comment-form-wrapper">
        {% if form.errors %}
          <div class="form-errors">
            <div class="error-message-wrapper">
              <div class="error-icon">
                {% render 'icon-failed' %}
              </div>
              <div class="error-text">Oh no! Your comment was not posted</div>
            </div>
            <ul class="error-list">
              {% for error in form.errors %}
                <li class="error-item">
                  <span>{{ form.errors.messages[error] }}</span>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% elsif form.posted_successfully? %}
          <div class="success-message-wrapper">
            <div class="success-icon">
              {% render 'icon-success' %}
            </div>
            <div class="success-text">Comment is posted successfully</div>
          </div>
        {% endif %}
        <div class="form-row">
          <div class="form-group">
            <label for="comment_author" class="form-label">Name</label>
            <input
              type="text"
              name="comment[author]"
              id="comment_author"
              class="form-input"
              placeholder="Jane Doe"
              required
            >
          </div>
          <div class="form-group">
            <label for="comment_email" class="form-label">Email</label>
            <input
              type="email"
              name="comment[email]"
              id="comment_email"
              class="form-input"
              placeholder="jane@doe.com"
              required
            >
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="comment_content" class="form-label">Comment</label>
            <textarea
              class="form-textarea"
              name="comment[body]"
              id="comment_content"
              required
            ></textarea>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <input
              type="submit"
              class="form-submit"
              value="Post comment"
            >
          </div>
        </div>
      </div>
    {% endform %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Template Article",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_author",
      "default": true,
      "label": "Display Author Name"
    },
    {
      "type": "checkbox",
      "id": "enable_published_date",
      "default": true,
      "label": "Display Published Date"
    }
  ],
  "blocks": [
    {
      "type": "article_title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "article_author",
      "name": "Author",
      "limit": 1
    },
    {
      "type": "article_published_date",
      "name": "Published Date",
      "limit": 1
    },
    {
      "type": "featured_image",
      "name": "Thumbnail",
      "limit": 1
    },
    {
      "type": "article_content",
      "name": "Content",
      "limit": 1
    }
  ]
}
{% endschema %}
