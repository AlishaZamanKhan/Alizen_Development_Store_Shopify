<link rel="stylesheet" href="{{ 'template-blog.css' | asset_url }}">

<div class="blog-container">
  {% if request.path contains '/tagged/' %}
    {% assign filter_applied = true %}
    {% assign split_path = request.path | split: '/tagged/' %}

    {% assign main_url = split_path[0] %}
    {% assign active_tags = split_path[1] | split: '+' %}
    {% assign current_tag = active_tags[0] | split: '' %}

  {% else %}
    {% assign filter_applied = true %}
  {% endif %}

  {% paginate blog.articles by 9 %}
    <div>
      <h1 class="blog-title">{{ blog.title }}</h1>
    </div>
    <div class="filter-article-count">
      <div class="filter-icon" onclick="openFilterDrawer()">
        <a onclick="openFilterDrawer()">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="20" viewBox="0 0 18 20" fill="none">
            <path d="M9 3L17 3L9 3ZM0.999999 17L4 17L0.999999 17ZM1 3L5 3L1 3ZM8 17L17 17L8 17ZM14 10L17 10L14 10ZM1 10L10 10L1 10Z" fill="#747474"></path>
            <path d="M9 3L17 3M0.999999 17L4 17M1 3L5 3M8 17L17 17M14 10L17 10M1 10L10 10" stroke="#747474" stroke-linecap="round"></path>
            <path d="M5 3C5 4.10457 5.89543 5 7 5C8.10457 5 9 4.10457 9 3C9 1.89543 8.10457 1 7 1C5.89543 1 5 1.89543 5 3Z" stroke="#747474" stroke-linecap="round"></path>
            <path d="M10 10C10 11.1046 10.8954 12 12 12C13.1046 12 14 11.1046 14 10C14 8.89543 13.1046 8 12 8C10.8954 8 10 8.89543 10 10Z" stroke="#747474" stroke-linecap="round"></path>
            <path d="M4 17C4 18.1046 4.89543 19 6 19C7.10457 19 8 18.1046 8 17C8 15.8954 7.10457 15 6 15C4.89543 15 4 15.8954 4 17Z" stroke="#747474" stroke-linecap="round"></path>
          </svg>
          <span>Filters</span></a
        >
      </div>
      <div class="article-count">
        <span>{{ blog.articles_count }} articles</span>
      </div>
      {% comment %} filter overlay {% endcomment %}
      <div class="filter-ovelay" onclick="closeFilterDrawer()"></div>
      {% comment %} Filter Drawer Starts here {% endcomment %}
      <div class="bp-filter-container">
        <div class="bp-filter-drawer-container">
          <div class="bp-filter-drawer">
            <div class="bp-filter-drawer-header">
              <h1 class="bp-filter-drawer-title">Filters</h1>
              <div class="bp-filter-drawer-close-button" onclick="closeFilterDrawer()">
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M21 21L1 1M21 1L1 21" stroke="#AAAAAA" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </div>
            </div>
            <div class="bp-filter-drawer-content">
              {% for block in section.blocks %}
                {% assign linked_list = linklists[block.settings.filter_parameter] %}
                <div class="bp-filter-drawer-items">
                  <div class="bp-filter-drawer-item">
                    <h3>
                      {{ linked_list.title }}
                      {% render 'icon-dropdown' %}
                    </h3>

                    <div>
                      {% for link in linked_list.links %}
                        {% assign present_handle = link.url | split: '/tagged/' %}
                        <div class="bp-fd-item-link-container">
                          <label for="bp-fd-item-link-{{ link.url }}" class="bp-fd-item-link-label">
                            {{- link.title -}}
                          </label>
                          <input
                            value="{{ present_handle }}"
                            type="checkbox"
                            id="bp-fd-item-link-{{ link.url }}"
                            class="bp-fd-item-link-checkbox"
                            {% if active_tags contains present_handle %}
                              checked
                            {% endif %}
                          >
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
            <div class="bp-filter-drawer-footer">
              <button onclick="clearList()">Clear</button>
              <button onclick="applyFilter('{{ split_path[0] }}')">Apply Filters</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="blog-grid-container">
      {% for article in blog.articles %}
        <div class="ali-blog-card">
          <div class="ali-article-container">
            <div class="ali-image-container">
              {% if article.image %}
                <a href="{{ article.url }}">
                  <img
                    class="ali-blog-card-image"
                    src="{{ article.image | image_url }}"
                    alt="{{ article.image.alt }}"
                    height="70px"
                    width="50px"
                  >
                </a>
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'blog-card-image' }}
              {% endif %}
            </div>

            <div class="blog-card-content">
              <h1 class="blog-card-title">{{ article.title }}</h1>
              <br>
              {% if article.excerpt.size > 0 %}
                <p class="blog-card-excerpt">{{ article.excerpt | strip_html | truncatewords: 20 }}</p>
              {% else %}
                <p class="blog-card-excerpt">{{ article.content | strip_html | truncatewords: 20 }}</p>
              {% endif %}
              <br>
              <div class="author-details">
                <img
                  src="{{ article.user.image | image_url }}"
                  alt="Author Image"
                  height="100%"
                  width="100%"
                  class="author-image"
                >
                <p class="author-name">{{ article.author }}</p>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="pagination-container">
      {% render 'pagination', pagination: paginate %}
    </div>
  {% endpaginate %}
</div>

<script>
  function clearList() {
    checkboxList = document.getElementsByClassName('bp-fd-item-link-checkbox');

    Array.from(checkboxList).forEach((input) => {
      input.checked = false;
    });
  }
  function openFilterDrawer() {
    const drawer = document.querySelector('.bp-filter-container');
    drawer.style.left = '0';
    console.log('I have clicked filter icon');
    const overlay = document.querySelector('.filter-ovelay');
    overlay.style.display = 'block';
  }

  function closeFilterDrawer() {
    const drawer = document.querySelector('.bp-filter-container');
    drawer.style.left = '-150vh';
    const overlay = document.querySelector('.filter-ovelay');
    overlay.style.display = 'none';
  }

  function applyFilter(path) {
    const checklist = document.getElementsByClassName('bp-fd-item-link-checkbox');
    let url = path;
    let i = 0;
    Array.from(checklist).forEach((input) => {
      if (input.checked) {
        if (i == 0) {
          url = url + '/tagged/' + input.value;
          i++;
        } else {
          url += `+${input.value}`;
        }
      }
    });
    window.location = url;
  }
</script>

{% schema %}
{
  "name": "Blog",
  "settings": [],
  "blocks": [
    {
      "type": "blog_page",
      "name": "Blog Page",
      "settings": [
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author Image"
        }
      ]
    },
    {
      "type": "filter_parameter",
      "name": "Filter Parameter",
      "settings": [
        {
          "type": "link_list",
          "id": "filter_parameter",
          "label": "Add Filter Parameter"
        }
      ]
    }
  ]
}
{% endschema %}
