<link rel="stylesheet" href="{{ 'template-blog.css' | asset_url }}">

<div class="blog-container">
  {% paginate blog.articles by 9 %}
    <h1 class="blog-title">{{ blog.title }}</h1>
    <div class="filter-article-count">
      <div>{% render 'icon-filter' %}</div>
      <div>{{ blog.articles_count }}</div>
    </div>
    <div class="blog-grid-container">
      {% for article in blog.articles %}
        {% comment %}
          <div class="ali-blog-card-container">
          </div>
        {% endcomment %}
        <div class="ali-blog-card">
          <div class="ali-article-container">
            <div class="ali-image-container">
              {% if article.image %}
                <a href="{{ article.url }}">
                  <img
                    class="ali-blog-card-image"
                    src="{{ article.image | image_url }}"
                    alt="{{ article.image.alt }}"
                    height="70px"
                    width="50px"
                  >
                </a>
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'blog-card-image' }}
              {% endif %}
            </div>

            <div class="blog-card-content">
              <h1 class="blog-card-title">{{ article.title }}</h1>
              <br>
              {% if article.excerpt.size > 0 %}
                <p class="blog-card-excerpt">{{ article.excerpt | strip_html | truncatewords: 20 }}</p>
              {% else %}
                <p class="blog-card-excerpt">{{ article.content | strip_html | truncatewords: 20 }}</p>
              {% endif %}
              <br>
              <div class="author-details">
                <img
                  src="{{ article.user.image | image_url }}"
                  alt="Author Image"
                  height="100%"
                  width="100%"
                  class="author-image"
                >

                <p class="author-name">{{ article.author }}</p>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="pagination-container">
      {% render 'pagination', pagination: paginate %}
    </div>
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "Blog",
  "settings": [],
  "blocks": [
    {
      "type": "blog_page",
      "name": "Blog Page",
      "settings": [
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author Image"
        }
      ]
    }
  ]
}
{% endschema %}
