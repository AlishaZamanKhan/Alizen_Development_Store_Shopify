<!doctype html>
<html>
  <head>
    <title>{{ page_title }}</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="description" content="{{ page_description | escape }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">

    {{ content_for_header }}
    <!-- Header hook for plugins -->

    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="{{ 'global.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'collection.css' | asset_url }}">
    <style>
      .zipcode-error {
  color: #dc3545;
  margin-top: 0.5rem;
  font-size: 0.875rem;
}
    </style>
    {% comment %} {{ 'application.js' | asset_url | script_tag }} {% endcomment %}
    <script link="application.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  </head>
  <body>
    <div class="page-wrapper">
      <header>
        {% section 'header' %}
        {% section 'mega-nav' %}
      </header>
      <main class="main-content" role="main">
        {{ content_for_layout }}
      </main>
      <div class="site-footer">
        {% section 'footer' %}
      </div>
    </div>
    <script>
      const CANARY_ISLANDS_POSTCODES = Array.from(
  { length: 2000 }, 
  (_, i) => (Math.floor(i / 1000) === 0 ? '35' : '38') + i.toString().padStart(3, '0')
);

// Add this script to your theme.liquid file, just before the closing </body> tag
document.addEventListener('DOMContentLoaded', function() {
  // Function to validate postcode
  function isCanaryIslandsPostcode(postcode) {
    return CANARY_ISLANDS_POSTCODES.some(prefix => postcode.startsWith(prefix));
  }

  // Function to show error message
  function showError(message) {
    const errorDiv = document.createElement('div');
    errorDiv.className = 'zipcode-error';
    errorDiv.style.color = 'red';
    errorDiv.style.marginTop = '10px';
    errorDiv.textContent = message;
    return errorDiv;
  }

  // Function to remove existing error messages
  function removeExistingErrors() {
    document.querySelectorAll('.zipcode-error').forEach(el => el.remove());
  }

  // Function to handle zip code validation
  function validateZipCode(zipCodeField) {
    const zipCode = zipCodeField.value.trim();
    removeExistingErrors();

    if (isCanaryIslandsPostcode(zipCode)) {
      const error = showError('We apologize, but we currently do not deliver to the Canary Islands.');
      zipCodeField.parentNode.appendChild(error);
      
      // Disable checkout button if it exists
      const checkoutButton = document.querySelector('[name="checkout"], .checkout-button');
      if (checkoutButton) {
        checkoutButton.disabled = true;
        checkoutButton.style.opacity = '0.5';
      }
      return false;
    }

    // Re-enable checkout button
    const checkoutButton = document.querySelector('[name="checkout"], .checkout-button');
    if (checkoutButton) {
      checkoutButton.disabled = false;
      checkoutButton.style.opacity = '1';
    }
    return true;
  }

  // Function to initialize the validation
  function initZipCodeValidation() {
    // Monitor cart page
    const zipField = document.querySelector('#checkout_shipping_address_zip');
    if (zipField) {
      zipField.addEventListener('change', () => validateZipCode(zipField));
      zipField.addEventListener('blur', () => validateZipCode(zipField));
    }

    // Monitor shipping calculator on cart page
    const calculatorZipField = document.querySelector('#address_zip');
    if (calculatorZipField) {
      calculatorZipField.addEventListener('change', () => validateZipCode(calculatorZipField));
      calculatorZipField.addEventListener('blur', () => validateZipCode(calculatorZipField));
    }

    // Validate on form submission
    document.addEventListener('submit', function(e) {
      if (e.target.id === 'checkout_form') {
        const zipField = e.target.querySelector('#checkout_shipping_address_zip');
        if (zipField && !validateZipCode(zipField)) {
          e.preventDefault();
          window.scrollTo({ top: zipField.offsetTop - 100, behavior: 'smooth' });
        }
      }
    });
  }

  // Initialize the validation
  initZipCodeValidation();
});
    </script>
  </body>
</html>
